{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,

    "declaration": true,
    "sourceMap": true,
    "declarationMap": true
  },
  "include": ["main.ts", "src/**/*"]
}